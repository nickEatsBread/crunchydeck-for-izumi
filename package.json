{
  "name": "crunchyroll-source-izumi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crunchyroll onlinestream source for Izumi. Requires a Crunchyroll account.",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/match.test.ts test/device.test.ts test/license.test.ts",
    "test:live": "tsx --test test/live.test.ts",
    "import-cookies": "tsx src/cli/import-cookies.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "puppeteer-core": "^24.15.0",
    "undici": "^7.15.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
