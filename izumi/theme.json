{
  "app": "izumi",
  "kind": "theme-package",
  "schemaVersion": 1,
  "themeApi": 7,
  "id": "crunchy-deck",
  "name": "Crunchy Deck",
  "version": "2.0.0",
  "author": "Crunchy Deck",
  "description": "Crunchy Deck's look: Crunchyroll orange on near-black, a slide-in menu instead of a top bar or rail, a tall featured banner with the title logo, Sub | Dub and the age rating, cards with their titles on the artwork, and season pills over an episode grid.",
  "design": {
    "tokens": {
      "scheme": "dark",
      "background": "0 0% 4%",
      "foreground": "0 0% 100%",
      "muted": "0 0% 12%",
      "mutedForeground": "0 0% 55%",
      "primary": "24 91% 54%",
      "primaryForeground": "0 0% 0%",
      "secondary": "0 0% 12%",
      "secondaryForeground": "0 0% 100%",
      "accent": "0 0% 16%",
      "accentForeground": "0 0% 100%",
      "border": "0 0% 16%",
      "input": "0 0% 12%",
      "ring": "24 91% 54%",
      "card": "0 0% 8%",
      "cardForeground": "0 0% 100%",
      "theme": "24 91% 54%"
    },
    "radius": 0.75,
    "font": "nunito",
    "fonts": { "ui": "nunito", "heading": "nunito", "display": "nunito" },
    "fontScale": 1,
    "backdrop": "solid",
    "backdropStrength": 0,
    "glassBlur": 0,
    "presentation": {
      "density": "comfortable",
      "trueBlack": false,
      "hideCardLabels": false,
      "cardPreview": "none",
      "shell": { "nav": "drawer", "compact": false, "overlay": "none", "press": "none" },
      "hero": {
        "height": 66,
        "rotate": true,
        "interval": 7,
        "rankHidden": true,
        "limit": 7,
        "transition": "fade",
        "indicator": { "style": "bars", "position": "end", "color": "#F47521", "past": "empty" },
        "template": {
          "type": "overlay",
          "part": "cd-hero",
          "children": [
            { "type": "artwork", "artwork": "backdrop", "part": "cd-hero-art", "style": { "anchor": "fill", "fit": "cover" } },
            {
              "type": "stack",
              "part": "cd-hero-body",
              "style": { "anchor": "bottom-start" },
              "children": [
                { "type": "artwork", "artwork": "logo", "part": "cd-hero-logo", "when": { "field": "logo" }, "style": { "fit": "contain" } },
                { "type": "text", "field": "title", "part": "cd-hero-title", "when": { "field": "logo", "absent": true } },
                {
                  "type": "row",
                  "part": "cd-hero-meta",
                  "children": [
                    { "type": "text", "field": "ageRating", "part": "cd-rating", "when": { "field": "ageRating" } },
                    { "type": "text", "text": "◆", "part": "cd-sep", "when": { "field": "audio" } },
                    { "type": "text", "field": "audio", "part": "cd-meta-text", "when": { "field": "audio" } },
                    { "type": "text", "text": "◆", "part": "cd-sep", "when": { "field": "genre" } },
                    {
                      "type": "row",
                      "part": "cd-genres",
                      "when": { "field": "genre" },
                      "children": [
                        { "type": "text", "field": "genre", "part": "cd-meta-text" },
                        { "type": "text", "text": ",", "part": "cd-meta-text", "when": { "field": "genre2" } },
                        { "type": "text", "field": "genre2", "part": "cd-meta-text", "when": { "field": "genre2" } },
                        { "type": "text", "text": ",", "part": "cd-meta-text", "when": { "field": "genre3" } },
                        { "type": "text", "field": "genre3", "part": "cd-meta-text", "when": { "field": "genre3" } }
                      ]
                    }
                  ]
                },
                { "type": "text", "field": "description", "part": "cd-hero-synopsis", "when": { "field": "description" } },
                {
                  "type": "row",
                  "part": "cd-hero-actions",
                  "children": [
                    { "type": "action", "action": "play", "text": "Continue", "part": "cd-play", "when": { "field": "progress" } },
                    { "type": "action", "action": "play", "text": "Start Watching", "part": "cd-play", "when": { "field": "progress", "absent": true } },
                    { "type": "action", "action": "details", "text": "Details", "part": "cd-details" }
                  ]
                }
              ]
            }
          ]
        }
      },
      "detail": {
        "layout": "overlay",
        "title": "text",
        "sections": { "mode": "stack", "tabs": ["episodes"], "unlisted": "hidden" },
        "episodes": {
          "seasons": "chips",
          "arrangement": "grid",
          "toolbar": "header",
          "card": {
            "type": "stack",
            "part": "cd-ep",
            "children": [
              {
                "type": "overlay",
                "part": "cd-ep-art",
                "style": { "aspect": "16 / 9" },
                "children": [
                  { "type": "artwork", "artwork": "still", "part": "cd-ep-still", "style": { "anchor": "fill", "fit": "cover" } },
                  { "type": "text", "field": "watched", "part": "cd-ep-badge", "when": { "field": "watched" } },
                  {
                    "type": "stack",
                    "part": "cd-ep-unwatched",
                    "when": { "field": "watched", "absent": true },
                    "children": [
                      { "type": "text", "field": "duration", "part": "cd-ep-badge", "when": { "field": "duration" } },
                      { "type": "meter", "field": "progress", "part": "cd-ep-progress", "when": { "field": "progress", "atMost": 99 } }
                    ]
                  }
                ]
              },
              {
                "type": "row",
                "part": "cd-ep-number",
                "children": [
                  { "type": "text", "text": "Episode", "part": "cd-ep-number-text" },
                  { "type": "text", "field": "episodeNo", "part": "cd-ep-number-text" }
                ]
              },
              { "type": "text", "field": "episodeTitle", "part": "cd-ep-title" },
              { "type": "text", "field": "description", "part": "cd-ep-synopsis", "when": { "field": "description" } }
            ]
          }
        }
      }
    }
  }
}
